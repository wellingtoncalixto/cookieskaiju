NEXT_PUBLIC_SITE_URL=https://www.cookieskaiju.com.br
NEXT_PUBLIC_WHATSAPP=5519984268415
# true libera o próximo sábado e domingo a qualquer hora (para testar). Em produção: false.
NEXT_PUBLIC_MODO_TESTE=false
# OBRIGATÓRIAS: coordenadas do CEP 13808-113 (origem das entregas; não aparecem no site).
LOJA_LAT=-22.450558
LOJA_LON=-46.935937
NOMINATIM_USER_AGENT="CookiesKaiju/1.0 (contato: WhatsApp +55 19 98426-8415)"
# Opcional: se preenchida, o cálculo da rota usa a Google Routes API
GOOGLE_MAPS_API_KEY=

# ---------- Banco de dados (Neon, pela integração da Vercel) ----------
# Criada sozinha ao conectar o Neon ao projeto. Sem ela, o site usa o cardápio de src/config/loja.ts.
# No computador, dá para usar um banco embutido: DATABASE_URL=pglite:.dados/dev (só desenvolvimento).
DATABASE_URL=
# Senha do usuário SÓ DE LEITURA gpt_leitura, para o ChatGPT (veja docs/ADMIN.md).
GPT_LEITURA_SENHA=
# Opcional: URL completa do usuário de leitura (senão é montada a partir de DATABASE_URL).
DATABASE_URL_LEITURA=

# ---------- Registro de pedidos ----------
# true: cada pedido do site ganha um código CK-… e é gravado no banco (sem dados pessoais).
NEXT_PUBLIC_REGISTRO_PEDIDOS=false
# Segredo para assinar as cotações de frete (gere um aleatório; nunca commite).
FRETE_COTACAO_SEGREDO=

# ---------- Admin (/admin) ----------
ADMIN_SENHA=
# Segredo da sessão (gere um aleatório com 32+ caracteres; nunca commite).
ADMIN_SEGREDO_SESSAO=

# ---------- Fotos dos produtos (Vercel Blob) ----------
# Criada sozinha ao conectar o Blob ao projeto.
BLOB_READ_WRITE_TOKEN=

# ---------- ChatGPT (GPT personalizado) ----------
# Chave que o GPT envia (Authorization: Bearer …). Gere uma aleatória com 32+ caracteres.
GPT_API_CHAVE=

# ---------- Leitura de notas de compra (admin → Compras) ----------
# Chave da API da Anthropic (console.anthropic.com → API Keys). Cada nota lida custa alguns centavos.
ANTHROPIC_API_KEY=
